  214          void Normalization(uint16_t *adcRaw, uint16_t *adcMax, uint16_t *adcMin, float *adcAfterNorm)
  215          {
  216   1          uint8_t i;
  217   1          // 对每个ADC通道进行归一化处理
  218   1          for (i = 0; i < 4; i++) {
