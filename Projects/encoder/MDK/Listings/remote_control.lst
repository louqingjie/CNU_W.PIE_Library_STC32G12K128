   38   1        for(i = 1; i < 11; i++)
   39   1          check += data_t[i];
   40   1        if(check != data_t[11]) return 0;//帧尾校验失败
   41   1         
   42   1        //解包
   43   1        rc_ctrl.rocker.value[0] = (int16_t)(data_t[1] | data_t[2] << 8);
   44   1        rc_ctrl.rocker.value[1] = (int16_t)(data_t[3] | data_t[4] << 8);
   45   1        rc_ctrl.rocker.value[2] = (int16_t)(data_t[5] | data_t[6] << 8);
   46   1        rc_ctrl.rocker.value[3] = (int16_t)(data_t[7] | data_t[8] << 8);
   47   1        rc_ctrl.key.value = (uint16_t)(data_t[9] | data_t[10] << 8);
   48   1        return 1;
   49   1      }
