  323          /// @brief ADC数据归一化处理
  324          /// @return 归一化后的误差值(-1~1)
  325          float Normalization(uint16_t *adcRaw, uint16_t *adcMax, uint16_t *adcMin)
  326          {
  327   1          uint8_t i;
  328   1          double  adcAfterNorm[4], adcL, adcR;
  329   1          char    adcNormLine[4][22];
  330   1          uint8_t warningOfADC[4], xOfWarning[4] = {4, 9, 11, 17};
  331   1      
  332   1          // 对每个ADC通道进行归一化处理
  333   1          for (i = 0; i < 4; i++) {
  334   2              // 边界检查
  335   2              if (adcRaw[i] > adcMax[i]) { // 超上限
  336   3                  adcRaw[i] = adcMax[i];
  337   3                  GPIO_Write_Bit(LED(i), 0); // LED报警
  338   3                  warningOfADC[i] = 1;
  339   3              } else if (adcRaw[i] < adcMin[i]) { // 超下限
  340   3                  adcRaw[i] = adcMin[i];
  341   3                  GPIO_Write_Bit(LED(i), 0);
  342   3                  warningOfADC[i] = -1;
  343   3              } else {
  344   3                  warningOfADC[i] = 0;
  345   3              }
  346   2      
  347   2              // 归一化计算：将ADC值映射到0~1范围
  348   2              adcAfterNorm[i] = (float)(adcRaw[i] - adcMin[i]) / (adcMax[i] - adcMin[i]);
  349   2              sprintf(adcNormLine[i], "%.2f", adcAfterNorm[i]);
  350   2          }
  351   1      
  352   1          // 显示归一化后的值
  353   1          if (biosKey % 5 == 1) {
  354   2              sprintf(adcNormLine[0], "%s %s   %s %s", adcNormLine[0], adcNormLine[1], adcNormLine[2], adcNormL
             -ine[3]);
  355   2              LCD_P6x8Str(0, 1, adcNormLine[0]);
  356   2          }
  357   1      
  358   1          // 计算左右两侧传感器的平均值
  359   1          adcL = (adcAfterNorm[0] * 0.7 + adcAfterNorm[1] * 1.3) / 2; // 左侧平均值
  360   1          adcR = (adcAfterNorm[2] * 0.7 + adcAfterNorm[3] * 1.3) / 2; // 右侧平均值
  361   1      
  362   1          // 显示左右侧数值
  363   1          if (biosKey % 5 == 1) {
  364   2              sprintf(adcNormLine[0], "%.3f->", adcL);
  365   2              LCD_P6x8Str(0, 2, adcNormLine[0]);
  366   2              sprintf(adcNormLine[0], "<-%.3f", adcR);
  367   2              LCD_P6x8Str(84, 2, adcNormLine[0]);
  368   2          }
  369   1          // 计算并返回归一化误差：(左侧-右侧)/(左侧+右侧)
  370   1          return (adcL - adcR) / (adcL + adcR + 0.001); // +0.001防止除零
  371   1      }
