  259          float ADC_To_Error(float *adcAfterNorm, float kA, float kB)
  260          {
  261   1          num = kA * (adcAfterNorm[0] - adcAfterNorm[3]) + kB * (adcAfterNorm[1] - adcAfterNorm[2]);
  262   1          den = kA * (adcAfterNorm[0] + adcAfterNorm[3]) + kB * fabs(adcAfterNorm[1] - adcAfterNorm[2]);
  263   1          if (fabs(den) < 1e-6f)
  264   1              return 0.0f;
  265   1          return (float)num / den;
  266   1      }
  267          
  268          float PD_Calculate(float error, float lastError, float kp, float kd)
  269          {
  270   1      
  271   1          derivative = kd * (error - lastError);
  272   1          output     = kp * error + derivative;
  273   1          if (output > 1)
  274   1              output = 1;
  275   1          else if (output < -1)
  276   1              output = -1;
  277   1          return output;
  278   1      }
