  393          
  394          void Go(uint16_t minSpeed, uint16_t maxSpeed, float currentError, float lastError)
  395          {
  396   1          int speed = (int)((maxSpeed - minSpeed) * abs(currentError - lastError) / 2) + minSpeed;
  397   1          if (speed > maxSpeed)
  398   1              speed = maxSpeed;
  399   1          else if (speed < minSpeed)
  400   1              speed = minSpeed;
  401   1          PWM_SET_Duty(MOTOR_L, 10000 - speed);
  402   1          PWM_SET_Duty(MOTOR_R, 10000 - speed);
  403   1      }
