  451          /// @brief P4口外部中断服务函数（方向键中断）
  452          void P4_EXTI_Activated() interrupt P4INT_VECTOR
  453          {
  454   1          GPIO_EXTI_Flag_Read(GPIO_P4);
  455   1          if (Port_Exti_Flag[4]) {
  456   2              GPIO_EXTI_Flag_Clear(GPIO_P4);
  457   2      
  458   2              // 根据当前BIOS页面调整不同参数
  459   2              if (Port_Exti_Flag[4] & Port_Pin_2) { // 上键：增加参数
  460   3                  if (biosKey % 4 == 1)
  461   3                      maxSpeed += 50;
  462   3                  else if (biosKey % 4 == 2)
  463   3                      minSpeed += 50;
  464   3                  else if (biosKey % 4 == 3)
  465   3                      kA += 0.05;
  466   3              } else if (Port_Exti_Flag[4] & Port_Pin_6) { // 下键：减小参数
  467   3                  if (biosKey % 4 == 1)
  468   3                      maxSpeed -= 50;
  469   3                  else if (biosKey % 4 == 2)
  470   3                      minSpeed -= 50;
  471   3                  else if (biosKey % 4 == 3)
  472   3                      kA -= 0.05;
  473   3              } else if (Port_Exti_Flag[4] & Port_Pin_1) { // 右键：增加PID参数
  474   3                  if (biosKey % 4 == 1)
  475   3                      kp += 0.1;
  476   3                  else if (biosKey % 4 == 2)
  477   3                      kd += 0.05;
  478   3                  else if (biosKey % 4 == 3)
  479   3                      kB += 0.05;
  480   3              } else if (Port_Exti_Flag[4] & Port_Pin_5) { // 左键：减小PID参数
  481   3                  if (biosKey % 4 == 1)
  482   3                      kp -= 0.1;
  483   3                  else if (biosKey % 4 == 2)
  484   3                      kd -= 0.05;
  485   3                  else if (biosKey % 4 == 3)
  486   3                      kB -= 0.05;
  487   3              }
  488   2          }
  489   1      }


