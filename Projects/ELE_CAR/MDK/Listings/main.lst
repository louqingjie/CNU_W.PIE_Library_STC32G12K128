  458          float PID_Calculate(float error, float kp, float ki, float kd, float maxAbsI)
  459          {
  460   1        float output;
  461   1        sumOfError += error;
  462   1        if (sumOfError > maxAbsI)
  463   1          sumOfError = maxAbsI;
  464   1        else if (sumOfError < -maxAbsI)
  465   1          sumOfError = -maxAbsI;
  466   1        output = kp * error +
  467   1             ki * sumOfError +
  468   1             kd * (error - lastError);
  469   1        if (output > 1)
  470   1          output = 1;
  471   1        else if (output < -1)
  472   1          output = -1;
  473   1        lastError = error;
  474   1        return output;
  475   1      }
