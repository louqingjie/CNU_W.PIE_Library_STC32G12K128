  408   1          PIT_Timer_Clear(TIM0);
  409   1          Get_ADC(adcRaw, adcPin);                                       // 获取ADC采样值
  410   1          Normalization(adcRaw, adcMax, adcMin, adcAfterNorm);           // 归一化处理
  411   1          error     = ADC_To_Error(adcAfterNorm, kA, kB);                // 计算误差值
  412   1          pidOut    = PD_Calculate(error, lastError, kp, kd);            // PID计算
  413   1          lastError = error;                                             // 更新上次误差
  414   1          Servo_Control_By_Error(pidOut, midDutyOfServo, maxChangeDuty); // 舵机控制
  415   1      }
