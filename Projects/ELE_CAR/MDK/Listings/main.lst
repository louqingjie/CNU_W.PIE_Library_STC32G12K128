  373          /// @brief PID控制器计算
  374          /// @return PID输出值(-1~1)
  375          float PID_Calculate(float error, float lastError, float kp, float ki, float kd, float maxAbsI)
  376          {
  377   1          char  pidLine[50];
  378   1          float output, derivative;
  379   1      
  380   1          // 积分项计算（带限幅）
  381   1          sumOfError += error;
  382   1          if (sumOfError > maxAbsI)
  383   1              sumOfError = maxAbsI;
  384   1          else if (sumOfError < -maxAbsI)
  385   1              sumOfError = -maxAbsI;
  386   1      
  387   1          // 微分项计算
  388   1          derivative = kd * (error - lastError);
  389   1      
  390   1          // PID输出计算
  391   1          output = kp * error + ki * sumOfError + derivative;
  392   1      
  393   1          // 输出限幅(-1~1)
  394   1          if (output > 1)
  395   1              output = 1;
  396   1          else if (output < -1)
  397   1              output = -1;
  398   1      
  399   1          lastError = error;
  400   1      
  401   1          // 显示PID参数和计算过程
