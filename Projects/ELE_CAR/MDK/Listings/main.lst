  339          /// @brief ADC数据归一化处理
  340          /// @return 归一化后的误差值(-1~1)
  341          float Normalization(uint16_t *adcRaw, uint16_t *adcMax, uint16_t *adcMin)
  342          {
  343   1          uint8_t i;
  344   1          double  adcAfterNorm[4], adcL, adcR;
  345   1          char    adcNormLine[4][22];
  346   1          uint8_t warningOfADC[4], xOfWarning[4] = {4, 9, 11, 17};
  347   1      
  348   1          // 对每个ADC通道进行归一化处理
  349   1          for (i = 0; i < 4; i++) {
  350   2              // 边界检查
  351   2              if (adcRaw[i] > adcMax[i]) { // 超上限
  352   3                  adcRaw[i] = adcMax[i];
  353   3                  GPIO_Write_Bit(LED(i), 0); // LED报警
  354   3                  warningOfADC[i] = 1;
  355   3              } else if (adcRaw[i] < adcMin[i]) { // 超下限
  356   3                  adcRaw[i] = adcMin[i];
  357   3                  GPIO_Write_Bit(LED(i), 0);
  358   3                  warningOfADC[i] = -1;
  359   3              } else {
  360   3                  warningOfADC[i] = 0;
  361   3              }
  362   2      
  363   2              // 归一化计算：将ADC值映射到0~1范围
  364   2              adcAfterNorm[i] = (float)(adcRaw[i] - adcMin[i]) / (adcMax[i] - adcMin[i]);
  365   2              sprintf(adcNormLine[i], "%.2f", adcAfterNorm[i]);
  366   2          }
  367   1      
  368   1          // 显示警告信息
  369   1          if (warningOfADC[i] == 1)
  370   1              LCD_P6x8Str(xOfWarning[i], 0, "!");
  371   1          else if (warningOfADC[i] == 1)
  372   1              LCD_P6x8Str(xOfWarning[i], 1, "!");
C251 COMPILER V5.60.0,  main                                                               20/11/25  14:46:46  PAGE 7   

  373   1      
  374   1          // 显示归一化后的值
  375   1          sprintf(adcNormLine[0], "%s %s   %s %s", adcNormLine[0], adcNormLine[1], adcNormLine[2], adcNormLine[
             -3]);
  376   1          LCD_P6x8Str(0, 1, adcNormLine[0]);
  377   1      
  378   1          // 计算左右两侧传感器的平均值
  379   1          adcL = (adcAfterNorm[0]*0.5 + adcAfterNorm[1]*1.5) / 2; // 左侧平均值
  380   1          adcR = (adcAfterNorm[2]*0.5 + adcAfterNorm[3]*1.5) / 2; // 右侧平均值
  381   1      
  382   1          // 显示左右侧数值
  383   1          sprintf(adcNormLine[0], "%.3f->", adcL);
  384   1          LCD_P6x8Str(0, 2, adcNormLine[0]);
  385   1          sprintf(adcNormLine[0], "<-%.3f", adcR);
  386   1          LCD_P6x8Str(84, 2, adcNormLine[0]);
  387   1      
  388   1          // 计算并返回归一化误差：(左侧-右侧)/(左侧+右侧)
  389   1          return (adcL - adcR) / (adcL + adcR + 0.001); // +0.001防止除零
  390   1      }
