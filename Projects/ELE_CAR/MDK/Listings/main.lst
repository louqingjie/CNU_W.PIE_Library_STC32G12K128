  423          /// @brief P0口外部中断服务函数（按键中断）
  424          void P0_EXTI_Activated() interrupt P0INT_VECTOR
  425          {
  426   1          GPIO_EXTI_Flag_Read(GPIO_P0);
  427   1          if (Port_Exti_Flag[0]) {
  428   2              GPIO_EXTI_Flag_Clear(GPIO_P0);
  429   2              if (Port_Exti_Flag[0] & Port_Pin_7) {
  430   3                  if (GPIO_Read_Bit(DPAD_MID) == 0)
  431   3                      biosKey++; // 按键1：切换BIOS页面
  432   3              } else if (Port_Exti_Flag[0] & Port_Pin_6) {
  433   3                  biosKey = 0;
  434   3              } // 按键2：退出BIOS
  435   2              //  else if (Port_Exti_Flag[0] & Port_Pin_4) {
  436   2              //     encoderNum[0]++;
  437   2              // }
  438   2          }
  439   1      }
