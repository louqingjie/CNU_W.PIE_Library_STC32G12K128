  477          void Servo_Control_By_Error(float errorInner)
  478          {
  479   1        if (errorInner > 1)
  480   1          errorInner = 1;
  481   1        else if (errorInner < -1)
  482   1          errorInner = -1;
  483   1        PWM_SET_Frequency(SERVO, 50, midDutyOfServo + (int)maxChangeDuty * errorInner);
  484   1      }
  485          
  486          void Go(uint16_t minSpeed, uint16_t maxSpeed)
  487          {
  488   1        int speed = (int)((maxSpeed - minSpeed) * abs(lastError) / 2) + minSpeed;
  489   1        if (speed > maxSpeed)
  490   1          speed = maxSpeed;
  491   1        else if (speed < minSpeed)
  492   1          speed = minSpeed;
  493   1        PWM_SET_Duty(MOTOR_L, 10000 - speed);
  494   1        PWM_SET_Duty(MOTOR_R, 10000 - speed);
  495   1      }


