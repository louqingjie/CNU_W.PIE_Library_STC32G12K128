  447   3                  if (biosKey % 4 == 1)
  448   3                      maxSpeed -= 50;
  449   3                  else if (biosKey % 4 == 2)
  450   3                      minSpeed -= 50;
  451   3                  else if (biosKey % 4 == 3)
