  213          /// @brief ADC数据归一化处理
  214          /// @return 归一化后的误差值(-1~1)
  215          void Normalization(uint16_t *adcRaw, uint16_t *adcMax, uint16_t *adcMin, float *adcAfterNorm)
  216          {
  217   1          uint8_t i;
  218   1          // 对每个ADC通道进行归一化处理
  219   1          for (i = 0; i < 4; i++) {
  220   2              // 边界检查
  221   2              if (adcRaw[i] > adcMax[i]) { // 超上限
  222   3                  adcRaw[i] = adcMax[i];
  223   3              } else if (adcRaw[i] < adcMin[i]) { // 超下限
  224   3                  adcRaw[i] = adcMin[i];
  225   3              }
  226   2              adcAfterNorm[i] = (float)(adcRaw[i] - adcMin[i]) / (adcMax[i] - adcMin[i]);
  227   2          }
  228   1      }
  229          
  230          float ADC_To_Error(float *adcAfterNorm, float kA, float kB)
  231          {
  232   1          float num = kA * (adcAfterNorm[0] - adcAfterNorm[3]) + kB * (adcAfterNorm[1] - adcAfterNorm[2]);
  233   1          float den = kA * (adcAfterNorm[0] + adcAfterNorm[3]) + kB * fabs(adcAfterNorm[1] - adcAfterNorm[2]);
  234   1          return (float)num / den;
  235   1      }
  236          
  237          float PD_Calculate(float error, float lastError, float kp, float kd)
  238          {
  239   1          float output, derivative;
  240   1          derivative = kd * (error - lastError);
  241   1          output     = kp * error + derivative;
  242   1          if (output > 1)
  243   1              output = 1;
  244   1          else if (output < -1)
  245   1              output = -1;
  246   1          return output;
  247   1      }
