  414          
  415          void Go(uint16_t minSpeed, uint16_t maxSpeed, float currentError, float lastError)
  416          {
  417   1          int speed = (int)((maxSpeed - minSpeed) * abs(currentError - lastError) / 2) + minSpeed;
  418   1          if (speed > maxSpeed)
  419   1              speed = maxSpeed;
  420   1          else if (speed < minSpeed)
  421   1              speed = minSpeed;
  422   1          PWM_SET_Duty(MOTOR_L, 10000 - speed);
  423   1          PWM_SET_Duty(MOTOR_R, 10000 - speed);
  424   1      }
  425          
  426          void Stop_Inner()
  427          {
  428   1          PWM_SET_Frequency(SERVO, 50, midDutyOfServo);
  429   1          PWM_SET_Duty(MOTOR_L, 10000);
  430   1          PWM_SET_Duty(MOTOR_R, 10000);
  431   1      }
