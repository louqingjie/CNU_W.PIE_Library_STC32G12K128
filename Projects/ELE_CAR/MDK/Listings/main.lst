  393   1          // 需要将指针转换为uint8_t*类型
  394   1          EEPROM_read_n(0, (uint8_t *)kp, 4);
  395   1          EEPROM_read_n(4, (uint8_t *)kd, 4);
  396   1          EEPROM_read_n(8, (uint8_t *)kA, 4);
  397   1          EEPROM_read_n(12, (uint8_t *)kB, 4);
  398   1          EEPROM_read_n(16, (uint8_t *)minSpeed, 2);
  399   1          EEPROM_read_n(18, (uint8_t *)maxSpeed, 2);
  400   1      }
