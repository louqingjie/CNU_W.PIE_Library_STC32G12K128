  322          
  323          float PID_Calculate(float error, float lastError, float kp, float ki, float kd, float maxAbsI)
  324          {
  325   1          float output, sumOfError;
  326   1          sumOfError += error;
  327   1          if (sumOfError > maxAbsI)
  328   1              sumOfError = maxAbsI;
  329   1          else if (sumOfError < -maxAbsI)
  330   1              sumOfError = -maxAbsI;
  331   1          output = kp * error + ki * sumOfError + kd * (error - lastError);
  332   1          if (output > 1)
  333   1              output = 1;
  334   1          else if (output < -1)
  335   1              output = -1;
  336   1          lastError = error;
  337   1          return output;
  338   1      }
