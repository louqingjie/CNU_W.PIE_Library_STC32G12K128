  391          void EEPROM_Load(float *kp, float *kd, float *kA, float *kB, uint16_t *minSpeed, uint16_t *maxSpeed)
  392          {
  393   1          // 需要将指针转换为uint8_t*类型
  394   1          EEPROM_read_n(0xFE0400, (uint8_t *)kp, 4);
  395   1          EEPROM_read_n(0xFE0404, (uint8_t *)kd, 4);
  396   1          EEPROM_read_n(0xFE0408, (uint8_t *)kA, 4);
  397   1          EEPROM_read_n(0xFE040C, (uint8_t *)kB, 4);
  398   1          EEPROM_read_n(0xFE0410, (uint8_t *)minSpeed, 2);
  399   1          EEPROM_read_n(0xFE0412, (uint8_t *)maxSpeed, 2);
  400   1      }
