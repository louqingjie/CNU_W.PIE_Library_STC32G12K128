  449          /// @brief P4口外部中断服务函数（方向键中断）
  450          void P4_EXTI_Activated() interrupt P4INT_VECTOR
C251 COMPILER V5.60.0,  main                                                               23/11/25  23:21:49  PAGE 8   

  451          {
  452   1          GPIO_EXTI_Flag_Read(GPIO_P4);
  453   1          if (Port_Exti_Flag[4]) {
  454   2              GPIO_EXTI_Flag_Clear(GPIO_P4);
  455   2      
  456   2              // 根据当前BIOS页面调整不同参数
  457   2              if (Port_Exti_Flag[4] & Port_Pin_2) { // 上键：增加参数
  458   3                  if (biosKey % 4 == 1)
  459   3                      maxSpeed += 50;
  460   3                  else if (biosKey % 4 == 2)
  461   3                      minSpeed += 50;
  462   3                  else if (biosKey % 4 == 3)
  463   3                      kA += 0.05;
  464   3              } else if (Port_Exti_Flag[4] & Port_Pin_6) { // 下键：减小参数
  465   3                  if (biosKey % 4 == 1)
  466   3                      maxSpeed -= 50;
  467   3                  else if (biosKey % 4 == 2)
  468   3                      minSpeed -= 50;
  469   3                  else if (biosKey % 4 == 3)
  470   3                      kA -= 0.05;
  471   3              } else if (Port_Exti_Flag[4] & Port_Pin_1) { // 右键：增加PID参数
  472   3                  if (biosKey % 4 == 1)
  473   3                      kp += 0.1;
  474   3                  else if (biosKey % 4 == 2)
  475   3                      kd += 0.05;
  476   3                  else if (biosKey % 4 == 3)
  477   3                      kB += 0.05;
  478   3              } else if (Port_Exti_Flag[4] & Port_Pin_5) { // 左键：减小PID参数
  479   3                  if (biosKey % 4 == 1)
  480   3                      kp -= 0.1;
  481   3                  else if (biosKey % 4 == 2)
  482   3                      kd -= 0.05;
  483   3                  else if (biosKey % 4 == 3)
  484   3                      kB -= 0.05;
  485   3              }
  486   2          }
  487   1      }


