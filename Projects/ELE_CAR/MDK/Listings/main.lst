  452          /// @brief P4口外部中断服务函数（方向键中断）
  453          void P4_EXTI_Activated() interrupt P4INT_VECTOR
  454          {
  455   1          GPIO_EXTI_Flag_Read(GPIO_P4);
  456   1          if (Port_Exti_Flag[4]) {
  457   2              GPIO_EXTI_Flag_Clear(GPIO_P4);
  458   2      
  459   2              // 根据当前BIOS页面调整不同参数
  460   2              if (Port_Exti_Flag[4] & Port_Pin_2) { // 上键：增加参数
  461   3                  if (biosKey % 5 == 1)
  462   3                      maxSpeed += 50;
  463   3                  else if (biosKey % 5 == 2)
  464   3                      minSpeed += 50;
  465   3                  else if (biosKey % 5 == 3)
  466   3                      kA += 0.05;
  467   3                  else if (biosKey % 5 == 4)
  468   3                      SPLIT += 0.1;
  469   3      
  470   3              } else if (Port_Exti_Flag[4] & Port_Pin_6) { // 下键：减小参数
  471   3                  if (biosKey % 5 == 1)
  472   3                      maxSpeed -= 50;
  473   3                  else if (biosKey % 5 == 2)
  474   3                      minSpeed -= 50;
  475   3                  else if (biosKey % 5 == 3)
  476   3                      kA -= 0.05;
  477   3                  else if (biosKey % 5 == 4)
  478   3                      SPLIT -= 0.1;
  479   3              } else if (Port_Exti_Flag[4] & Port_Pin_1) { // 右键：增加PID参数
  480   3                  if (biosKey % 5 == 1)
  481   3                      kp += 0.05;
  482   3                  else if (biosKey % 5 == 2)
  483   3                      kd += 0.05;
  484   3                  else if (biosKey % 5 == 3)
  485   3                      kB += 0.05;
  486   3                  else if (biosKey % 5 == 4)
  487   3                      LOWER += 0.1;
  488   3              } else if (Port_Exti_Flag[4] & Port_Pin_5) { // 左键：减小PID参数
  489   3                  if (biosKey % 5 == 1)
  490   3                      kp -= 0.05;
  491   3                  else if (biosKey % 5 == 2)
  492   3                      kd -= 0.05;
  493   3                  else if (biosKey % 5 == 3)
  494   3                      kB -= 0.05;
  495   3                  else if (biosKey % 5 == 4)
  496   3                      LOWER -= 0.1;
  497   3              }
  498   2          }
  499   1      }


