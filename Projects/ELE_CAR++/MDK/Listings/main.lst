  240   2              if (adcRaw[i] > adcMax[i]) { // 超上限
  241   3                  adcRaw[i] = adcMax[i];
  242   3              } else if (adcRaw[i] < adcMin[i]) { // 超下限
  243   3                  adcRaw[i] = adcMin[i];
  244   3              }
  245   2              adcAfterNorm[i] = (float)(adcRaw[i] - adcMin[i]) / (adcMax[i] - adcMin[i]);
  246   2          }
  247   1      }
