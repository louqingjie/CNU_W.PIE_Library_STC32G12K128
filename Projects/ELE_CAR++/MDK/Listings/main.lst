  401          void P4_EXTI_Activated() interrupt P4INT_VECTOR
  402          {
  403   1          GPIO_EXTI_Flag_Read(GPIO_P4);
  404   1          if (Port_Exti_Flag[4]) {
  405   2              GPIO_EXTI_Flag_Clear(GPIO_P4);
  406   2      
  407   2              // 根据当前BIOS页面调整不同参数
  408   2              if (Port_Exti_Flag[4] & Port_Pin_2) { // 上键：增加参数
  409   3                  if (biosKey % 4 == 1)
  410   3                      maxSpeed += 50;
  411   3                  else if (biosKey % 4 == 2)
  412   3                      minSpeed += 50;
  413   3                  else if (biosKey % 4 == 3)
  414   3                      kA += 0.05;
  415   3              } else if (Port_Exti_Flag[4] & Port_Pin_6) { // 下键：减小参数
  416   3                  if (biosKey % 4 == 1)
  417   3                      maxSpeed -= 50;
  418   3                  else if (biosKey % 4 == 2)
  419   3                      minSpeed -= 50;
  420   3                  else if (biosKey % 4 == 3)
  421   3                      kA -= 0.05;
  422   3              } else if (Port_Exti_Flag[4] & Port_Pin_1) { // 右键：增加PID参数
  423   3                  if (biosKey % 4 == 1)
  424   3                      kp += 0.1;
  425   3                  else if (biosKey % 4 == 2)
  426   3                      kd += 0.05;
  427   3                  else if (biosKey % 4 == 3)
  428   3                      kB += 0.05;
  429   3              } else if (Port_Exti_Flag[4] & Port_Pin_5) { // 左键：减小PID参数
  430   3                  if (biosKey % 4 == 1)
  431   3                      kp -= 0.1;
  432   3                  else if (biosKey % 4 == 2)
  433   3                      kd -= 0.05;
  434   3                  else if (biosKey % 4 == 3)
  435   3                      kB -= 0.05;
  436   3              }
  437   2          }
  438   1      }


