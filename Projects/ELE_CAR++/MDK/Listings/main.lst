  205          /// @brief 获取ADC采样值（中值滤波）
  206          void Get_ADC(uint16_t *adcRaw, uint8_t *adcPin)
  207          {
  208   1          uint8_t  i, j, k;
  209   1          uint16_t temp, getADC[9];
  210   1      
  211   1          // 对每个ADC通道进行采样
  212   1          for (k = 0; k < 4; k++) {
  213   2              // 采样9次
  214   2              for (i = 0; i < 9; i++) {
  215   3                  getADC[i] = ADC_Read_Once(ADC[adcPin[k]], ADC_12BIT);
  216   3              }
  217   2      
  218   2              // 冒泡排序
  219   2              for (i = 1; i <= 9 - 1; i++) {
  220   3                  for (j = 0; j < 9 - i; j++) {
  221   4                      if (getADC[j] > getADC[j + 1]) {
  222   5                          temp          = getADC[j];
  223   5                          getADC[j]     = getADC[j + 1];
  224   5                          getADC[j + 1] = temp;
  225   5                      }
  226   4                  }
  227   3              }
  228   2              adcRaw[k] = getADC[4]; // 取中值作为最终结果
  229   2          }
  230   1      }
