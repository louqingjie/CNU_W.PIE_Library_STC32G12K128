  257          float PID_Calculate(float error, float lastError, float kp, float ki, float kd, float maxAbsI)
  258          {
  259   1          float output, sumOfError;
  260   1          sumOfError += error;
  261   1          if (sumOfError > maxAbsI)
  262   1              sumOfError = maxAbsI;
  263   1          else if (sumOfError < -maxAbsI)
  264   1              sumOfError = -maxAbsI;
  265   1          output = kp * error + ki * sumOfError + kd * (error - lastError);
  266   1          if (output > 1)
  267   1              output = 1;
  268   1          else if (output < -1)
  269   1              output = -1;
  270   1          lastError = error;
  271   1          return output;
  272   1      }
